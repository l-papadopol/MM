#!/bin/bash
set -euo pipefail
# Preserve executable-adjacent data before pkgbuild atomically replaces the app.
# User-folder data is outside the bundle and is never touched by this script.
volume="${3%/}"
old="$volume/Applications/MadModem.app/Contents/MacOS"
[[ -d "$old" ]] || exit 0
shopt -s nullglob dotglob
entries=()
for entry in "$old"/*; do
    case "${entry##*/}" in
        MadModem|managed-install.flag|cty.csv|rtty_rules|cw_rules|BUILD_INFO.txt|help|.DS_Store) continue ;;
    esac
    entries+=("$entry")
done
[[ ${#entries[@]} -gt 0 ]] || exit 0
backups="$volume/Library/Application Support/MadModem/Portable Backups"
mkdir -p "$backups"
backup="$(mktemp -d "$backups/$(date -u +%Y%m%dT%H%M%SZ)-XXXXXX")"
chmod 755 "$backup"
for entry in "${entries[@]}"; do
    ditto "$entry" "$backup/${entry##*/}"
done
printf 'Preserved previous portable data in %s\n' "$backup"
